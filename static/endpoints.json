    {
        "id": "upload-file",
        "name": "Upload File",
        "method": "POST",
        "path": "/api/file",
        "description": "Upload an image or video to Garage Sentinel.",
        "parameters": [
            {
                "name": "file",
                "in": "formData",
                "required": true,
                "type": "file",
                "description": "PNG, JPG, JPEG, or MP4. Maximum size: 10 MiB."
            }
        ],
        "requestType": "multipart/form-data",
        "responseType": "application/json",
        "status": 201,
        "response": {
            "id": 1
        }
    },
    {
        "id": "get-file",
        "name": "Get File",
        "method": "GET",
        "path": "/api/file/{storage_name}",
        "description": "Retrieve an uploaded image or video by its storage name. Images can optionally be returned as thumbnails.",
        "parameters": [
            {
                "name": "storage_name",
                "in": "path",
                "required": true,
                "type": "string",
                "description": "32-character lowercase hexadecimal storage identifier."
            },
            {
                "name": "size",
                "in": "query",
                "required": false,
                "type": "string",
                "default": "original",
                "description": "Set to thumbnail to retrieve a JPEG thumbnail for an image."
            }
        ],
        "responseType": "image/png, image/jpeg, video/mp4",
        "status": 200,
        "response": "Binary image or video content."
    },
